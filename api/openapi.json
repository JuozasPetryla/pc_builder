  "components": {
    "schemas": {
      "BuildCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Name",
            "examples": [
              "1440p Gaming PC"
            ]
          },
          "owner_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Owner Name",
            "examples": [
              "Juozas"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "is_public": {
            "type": "boolean",
            "title": "Is Public",
            "default": false
          },
          "component_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Component Ids"
          }
        },
        "type": "object",
        "required": [
          "name",
          "owner_name"
        ],
        "title": "BuildCreate"
      },
      "BuildRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "owner_name": {
            "type": "string",
            "title": "Owner Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "is_public": {
            "type": "boolean",
            "title": "Is Public"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentRead"
            },
            "type": "array",
            "title": "Components"
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/ReviewRead"
            },
            "type": "array",
            "title": "Reviews"
          },
          "compatibility": {
            "$ref": "#/components/schemas/CompatibilityRead"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "owner_name",
          "description",
          "is_public",
          "components",
          "reviews",
          "compatibility",
          "created_at",
          "updated_at"
        ],
        "title": "BuildRead"
      },
      "BuildReplace": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Name",
            "examples": [
              "1440p Gaming PC"
            ]
          },
          "owner_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Owner Name",
            "examples": [
              "Juozas"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
