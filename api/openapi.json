        ],
        "summary": "Pašalinti komponentą iš komplekto",
        "description": "Pašalina tik komponento susiejimą; katalogo komponentas lieka duomenų bazėje.",
        "operationId": "removeBuildComponent",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
