{
  "info": {
    "name": "PC Builder – komplektai ir bendras komponentų katalogas",
    "description": "JWT registracijos, sesijų ir API smoke testų rinkinys. Komponentai komplektuose pasirenkami iš esamo katalogo; kainų keitimui būtina admin rolė.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "buildId",
      "value": ""
    },
    {
      "key": "componentId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "otherBuildId",
      "value": ""
    },
    {
      "key": "otherComponentId",
      "value": ""
    },
    {
      "key": "catalogComponentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Registracija",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{authUsername}}\", \"password\": \"{{authPassword}}\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('authUsername', 'demo-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('authPassword', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 atsakymas', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('userId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Prisijungimas",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{authUsername}}\", \"password\": \"{{authPassword}}\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 atsakymas', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('accessToken', pm.response.json().access_token);",
              "pm.collectionVariables.set('refreshToken', pm.response.json().refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Mano paskyra",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
