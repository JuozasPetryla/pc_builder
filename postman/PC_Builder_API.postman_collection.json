      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 atsakymas', () => pm.response.to.have.status(200));",
              "pm.test('Sąrašas', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
